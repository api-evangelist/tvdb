{
  "opencollection": "1.0.0",
  "info": {
    "name": "TVDB API V4 Artwork Movies API",
    "version": "4.7.10"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Movies",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "TheTVDB Get All Movie",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api4.thetvdb.com/v4/movies",
            "params": [
              {
                "name": "page",
                "value": "1",
                "type": "query",
                "description": "page number"
              }
            ]
          },
          "docs": "returns list of movie base records"
        },
        {
          "info": {
            "name": "TheTVDB Get Movie Base",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api4.thetvdb.com/v4/movies/:id",
            "params": [
              {
                "name": "id",
                "value": "12345",
                "type": "path",
                "description": "id"
              }
            ]
          },
          "docs": "Returns movie base record"
        },
        {
          "info": {
            "name": "TheTVDB Get Movie Extended",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api4.thetvdb.com/v4/movies/:id/extended",
            "params": [
              {
                "name": "id",
                "value": "12345",
                "type": "path",
                "description": "id"
              },
              {
                "name": "meta",
                "value": "translations",
                "type": "query",
                "description": "meta"
              },
              {
                "name": "short",
                "value": "true",
                "type": "query",
                "description": "reduce the payload and returns the short version of this record without characters, artworks and trailers."
              }
            ]
          },
          "docs": "Returns movie extended record"
        },
        {
          "info": {
            "name": "TheTVDB Get Movies Filter",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api4.thetvdb.com/v4/movies/filter",
            "params": [
              {
                "name": "company",
                "value": "1",
                "type": "query",
                "description": "production company"
              },
              {
                "name": "contentRating",
                "value": "245",
                "type": "query",
                "description": "content rating id base on a country"
              },
              {
                "name": "country",
                "value": "usa",
                "type": "query",
                "description": "country of origin"
              },
              {
                "name": "genre",
                "value": "3",
                "type": "query",
                "description": "genre"
              },
              {
                "name": "lang",
                "value": "eng",
                "type": "query",
                "description": "original language"
              },
              {
                "name": "sort",
                "value": "score",
                "type": "query",
                "description": "sort by results"
              },
              {
                "name": "status",
                "value": "1",
                "type": "query",
                "description": "status"
              },
              {
                "name": "year",
                "value": "2020",
                "type": "query",
                "description": "release year"
              }
            ]
          },
          "docs": "Search movies based on filter parameters"
        },
        {
          "info": {
            "name": "TheTVDB Get Movie Base by Slug",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api4.thetvdb.com/v4/movies/slug/:slug",
            "params": [
              {
                "name": "slug",
                "value": "example-slug",
                "type": "path",
                "description": "slug"
              }
            ]
          },
          "docs": "Returns movie base record search by slug"
        },
        {
          "info": {
            "name": "TheTVDB Get Movie Translation",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api4.thetvdb.com/v4/movies/:id/translations/:language",
            "params": [
              {
                "name": "id",
                "value": "12345",
                "type": "path",
                "description": "id"
              },
              {
                "name": "language",
                "value": "eng",
                "type": "path",
                "description": "language"
              }
            ]
          },
          "docs": "Returns movie translation record"
        }
      ]
    }
  ],
  "bundled": true
}