{
  "opencollection": "1.0.0",
  "info": {
    "name": "TVDB API V4 Artwork Favorites API",
    "version": "4.7.10"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Favorites",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "TheTVDB Get User Favorites",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api4.thetvdb.com/v4/user/favorites"
          },
          "docs": "returns user favorites"
        },
        {
          "info": {
            "name": "TheTVDB Create User Favorites",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api4.thetvdb.com/v4/user/favorites",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "creates a new user favorite"
        }
      ]
    }
  ],
  "bundled": true
}